{
  "toolkit": "henrispec",
  "nome": "HenriSpec",
  "versao": "0.4.5",
  "lock": ".sdd/toolkit.lock.json",
  "backup": ".sdd/.toolkit-backup",
  "lockGlobal": "henrispec.lock.json",
  "lockGlobalAntigo": "sdd-toolkit.lock.json",
  "backupGlobal": ".henrispec-backup",
  "pendencias": {
    ".sdd/verificacao.json": "edite .sdd/verificacao.json: camadas e comandos vieram do molde de MFE Angular."
  },
  "posInstalacao": {
    "script": ".sdd/sdd.mjs",
    "args": [
      "validate"
    ],
    "titulo": "Validador nas mudanças abertas",
    "seFalhar": "mudanças abertas de versão anterior precisam dos campos novos: veja docs/henrispec/README.md, seção 14."
  },
  "excluir": [
    "/.sdd/",
    "/docs/henrispec/",
    "/docs/briefings/",
    "/docs/guia-contexto-e-modelos.md",
    "/.github/agents/henrispec-*.agent.md",
    "/.github/skills/henrispec-*/",
    "/.github/skills/sdd-workflow/"
  ],
  "instrucoes": {
    "arquivo": "instrucoes/henrispec.md",
    "marcador": "henrispec"
  },
  "ignorar": [
    "instrucoes/**"
  ],
  "regras": [
    {
      "origem": ".github/agents/henrispec-*.agent.md",
      "tipo": "gerenciado",
      "global": true
    },
    {
      "origem": ".github/skills/sdd-*/**",
      "tipo": "gerenciado",
      "global": true
    },
    {
      "origem": ".github/skills/henrispec-*/**",
      "tipo": "gerenciado",
      "global": true
    },
    {
      "origem": ".sdd/sdd.mjs",
      "tipo": "gerenciado"
    },
    {
      "origem": ".sdd/verificar.mjs",
      "tipo": "gerenciado"
    },
    {
      "origem": "docs/guia-contexto-e-modelos.md",
      "tipo": "gerenciado"
    },
    {
      "origem": "README.md",
      "tipo": "gerenciado",
      "destino": "docs/henrispec/README.md"
    },
    {
      "origem": "assets/**",
      "tipo": "gerenciado",
      "destino": "docs/henrispec/"
    },
    {
      "origem": ".sdd/verificacao.json",
      "tipo": "semente"
    },
    {
      "origem": ".sdd/padroes.md",
      "tipo": "semente"
    },
    {
      "origem": ".sdd/specs/index.md",
      "tipo": "semente"
    },
    {
      "origem": ".sdd/decisoes/index.md",
      "tipo": "semente"
    },
    {
      "origem": ".sdd/changes/.gitkeep",
      "tipo": "semente"
    },
    {
      "origem": "docs/briefings/EXEMPLO/briefing.md",
      "tipo": "semente"
    },
    {
      "origem": ".sdd/henrispec.json",
      "tipo": "semente"
    }
  ],
  "removidos": [
    ".github/agents/sdd-archive.agent.md",
    ".github/agents/sdd-implement.agent.md",
    ".github/agents/sdd-plan.agent.md",
    ".github/agents/sdd-review.agent.md",
